# ===== Telegram =====
# 从 @BotFather 获取
TG_BOT_TOKEN=
# 推送目标频道：@username 或 -100xxxxxxxxxx（数字频道 ID）
TG_CHAT_ID=
# 分流频道（可选，未配置则回退 TG_CHAT_ID）：网盘链接推送目标
TG_CHAT_ID_115=
# 分流频道（可选，未配置则回退 TG_CHAT_ID）：ed2k 链接推送目标
TG_CHAT_ID_ED2K=
# 可使用 Bot 的管理员用户 ID（逗号分隔），从 @userinfobot 获取
TG_ADMIN_IDS=

# ===== TMDB =====
# 官方 API Key，申请：https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# TMDB 语言
TMDB_LANGUAGE=zh-CN

# ===== 115 网盘 =====
# 可选：读取分享走匿名 web 接口，无需 cookie。
# 仅当想用 /status 验证自有账号有效性时才填写，形如 "UID=xxx;CID=xxx;SEID=xxx;"
# 注意：直配优先于 PAN115_COOKIE_FILE；直配非空时无法用 /cookie 命令更新
PAN115_COOKIE=
# cookie 文件路径（一整行 cookie 字符串）。推荐用此方式：更新文件无需重启
# （巡检/目录监控/ /reload 均会热加载，失效自动告警 admin），
# 也可直接在 Bot 里 /cookie <串> 更新（写文件 + 探活 + 即时生效）
PAN115_COOKIE_FILE=./data/115cookie.txt
# 115 是否走代理（默认 false，走代理易触发风控）
PAN115_USE_PROXY=false
# 115 请求稳态间隔（秒，默认 1）：所有 115 请求共享统一令牌桶，
# margin 限速时自动翻倍降速、恢复后自动回落；调大更保守
PAN115_REQUEST_INTERVAL=1

# ===== 分享失效巡检（可选）=====
# 是否启用巡检（默认 true）：每 INSPECT_INTERVAL_HOURS 小时检查已推送的 115 分享，
# 失效自动撤卡（删除频道卡片消息）并告警
INSPECT_ENABLED=true
# 巡检间隔（小时，默认 6）
INSPECT_INTERVAL_HOURS=6
# 失效撤卡后是否私信 admin 汇总（默认 true）
INSPECT_NOTIFY=true
# 缺访问码提醒：巡检发现存活但访问码失效/未存档时私信 admin（默认 true）
INSPECT_NOTIFY_CODE=true
# 连续 N 轮巡检全部查询失败 → 告警疑似 IP 被限（默认 2）
INSPECT_ERROR_ALERT_ROUNDS=2
# 115 cookie 失效告警及恢复通知（默认 true）
COOKIE_ALERT=true

# ===== 目录监控 → 自动建永久分享（可选，需 115 cookie）=====
# 是否启用目录监控（默认 true）：/dir add 登记网盘目录后，其下新子目录
# 自动创建永久分享并推送卡片（每个子目录 = 一部剧/电影一张卡）
SHARE_WATCH_ENABLED=true
# 后台扫描间隔（分钟，默认 10）；/share 命令可随时手动触发一轮
SHARE_WATCH_INTERVAL_MINUTES=10
# 每轮扫描结果（成功/失败明细）私信 admin（默认 true；静默轮不打扰）
SHARE_WATCH_NOTIFY=true
# 推送成功后自动移入的归档目录（默认 /已分享；须配置在监控目录之外，
# 否则归档内容会被再次扫到；留空=不移动，仅数据库标记）
SHARE_ARCHIVE_DIR=/已分享

# ===== 代理（TG Bot API + TMDB API 必须走代理）=====
# 形如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=

# ===== 频道监控（可选，Telethon 用户账号）=====
# 申请：https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# 是否启用频道监控（默认 true）
MONITOR_ENABLED=true
# 登录态文件（随 data 卷持久化；推荐 Bot 内 /mon login 交互式登录）
MONITOR_SESSION=./data/monitor.session
# 监控配置存储路径
MONITOR_DB_PATH=./data/monitor.db
# 默认聚合窗口秒数（0=实时逐条，可被 /mon batch 覆盖）
MONITOR_BATCH_SECONDS=0
# 频道监控（Telethon）断连/重连/补扫等运行事件私信 admin（默认 true）
MONITOR_NOTIFY=true

# ===== 本地媒体流水线（目录A监控 → 高置信重命名 → 移入目录B） =====
# 总开关（默认 false）
LOCAL_MEDIA_ENABLED=false
# 目录A：待处理资源（递归监控，含子目录）
LOCAL_MEDIA_INPUT_DIR=
# 目录B：规范化输出（须在目录A之外；电影平铺，剧集按"片名 (年份)/Sxx/"分夹）
LOCAL_MEDIA_OUTPUT_DIR=
# 模拟模式：只出日志不实际移动（默认 true；观察拟名质量后改 false 实际流转）
LOCAL_MEDIA_DRY_RUN=true
# 扫描周期秒（默认 10）
LOCAL_MEDIA_INTERVAL_SECONDS=10
# 稳定判定轮数：连续 N 轮 size/mtime 无变化才算稳定（默认 3，即约 30s）
LOCAL_MEDIA_STABLE_ROUNDS=3
# 低置信卡死告警阈值天（同一文件超 N 天仍低置信 → warning 提示人工介入）
LOCAL_MEDIA_STUCK_DAYS=7

# ===== ed2k 流水线（目录B监控 → ed2k 哈希 → 移入目录C） =====
# 总开关（默认 false）
ED2K_ENABLED=false
# 目录B（= LOCAL_MEDIA_OUTPUT_DIR 通常一致，两处须同路径）
ED2K_INPUT_DIR=
# 目录C：ed2k 算出哈希后归档，后续供 cd2 / OpenList 上传（须在B之外）
ED2K_OUTPUT_DIR=
# 模拟模式：只哈希+写 ed2k_results.jsonl，不实际移动（默认 true）
ED2K_DRY_RUN=true
# 扫描周期秒（哈希重，默认 30）
ED2K_INTERVAL_SECONDS=30
# 稳定判定轮数（默认 3，即约 1.5 分钟；防哈希到半截文件）
ED2K_STABLE_ROUNDS=3
# 哈希失败卡死告警阈值天
ED2K_STUCK_DAYS=7

# ===== ed2k 推送（目录C结果 → 频道卡片） =====
# 总开关（默认 false）
ED2K_PUSH_ENABLED=false
# 模拟模式：只日志不实际推送（默认 true）
ED2K_PUSH_DRY_RUN=true
# 扫描周期秒（默认 60）
ED2K_PUSH_INTERVAL_SECONDS=60
# 卡死告警阈值天
ED2K_PUSH_STUCK_DAYS=7
# 每轮汇总私信 admin（默认 true）
ED2K_PUSH_REPORT_ADMIN=true
# 汇总同步到目标频道（默认 false，开了会刷频道）
ED2K_PUSH_REPORT_CHANNEL=false

# ===== 其他 =====
LOG_LEVEL=INFO
# SQLite 缓存路径
DB_PATH=./data/cache.db
# 是否彩色日志
LOG_COLOR=true
# 本地文件日志路径
LOG_FILE=./data/logs/mediapush.log

