# ===== Telegram =====
# 从 @BotFather 获取
TG_BOT_TOKEN=
# 推送目标频道：@username 或 -100xxxxxxxxxx（数字频道 ID）
TG_CHAT_ID=
# 分流频道（可选，未配置则回退 TG_CHAT_ID）：网盘链接推送目标
TG_CHAT_ID_115=
# 分流频道（可选，未配置则回退 TG_CHAT_ID）：ed2k 链接推送目标
TG_CHAT_ID_ED2K=
# 可使用 Bot 的管理员用户 ID（逗号分隔），从 @userinfobot 获取
TG_ADMIN_IDS=

# ===== TMDB =====
# 官方 API Key，申请：https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# TMDB 语言
TMDB_LANGUAGE=zh-CN

# ===== 115 网盘 =====
# 可选：读取分享走匿名 web 接口，无需 cookie。
# 仅当想用 /status 验证自有账号有效性时才填写，形如 "UID=xxx;CID=xxx;SEID=xxx;"
# 注意：直配优先于 PAN115_COOKIE_FILE；直配非空时无法用 /cookie 命令更新
PAN115_COOKIE=
# cookie 文件路径（一整行 cookie 字符串）。推荐用此方式：更新文件无需重启
# （巡检/目录监控/ /reload 均会热加载，失效自动告警 admin），
# 也可直接在 Bot 里 /cookie <串> 更新（写文件 + 探活 + 即时生效）。
# 首次启动自动创建空文件（空 = 未配置，匿名读取可用）
PAN115_COOKIE_FILE=./data/115cookie.txt
# 115 是否走代理（默认 false，走代理易触发风控）
PAN115_USE_PROXY=false
# 115 请求稳态间隔（秒，默认 1）：所有 115 请求共享统一令牌桶，
# margin 限速时自动翻倍降速、恢复后自动回落；调大更保守
PAN115_REQUEST_INTERVAL=1

# ===== 分享失效巡检（可选）=====
# 是否启用巡检（默认 true）：每 INSPECT_INTERVAL_HOURS 小时检查已推送的 115 分享，
# 失效自动撤卡（删除频道卡片消息）并告警
INSPECT_ENABLED=true
# 巡检间隔（小时，默认 6）
INSPECT_INTERVAL_HOURS=6
# 失效撤卡后是否私信 admin 汇总（默认 true）
INSPECT_NOTIFY=true
# 缺访问码提醒：巡检发现存活但访问码失效/未存档时私信 admin（默认 true）
INSPECT_NOTIFY_CODE=true
# 连续 N 轮巡检全部查询失败 → 告警疑似 IP 被限（默认 2）
INSPECT_ERROR_ALERT_ROUNDS=2
# 115 cookie 失效告警及恢复通知（默认 true）
COOKIE_ALERT=true

# ===== 目录监控 → 自动建永久分享（可选，需 115 cookie）=====
# 是否启用目录监控（默认 true）：/dir add 登记网盘目录后，其下新子目录
# 自动创建永久分享并推送卡片（每个子目录 = 一部剧/电影一张卡）
SHARE_WATCH_ENABLED=true
# 后台扫描间隔（分钟，默认 10）；/share 命令可随时手动触发一轮
SHARE_WATCH_INTERVAL_MINUTES=10
# 每轮扫描结果（成功/失败明细）私信 admin（默认 true；静默轮不打扰）
SHARE_WATCH_NOTIFY=true
# 推送成功后自动移入的归档目录（默认 /已分享；须配置在监控目录之外，
# 否则归档内容会被再次扫到；留空=不移动，仅数据库标记）
SHARE_ARCHIVE_DIR=/已分享
# 分享前目录结构标准化（默认 false）：
#   - 剧集季目录重命名：Season 1 / S01 / 第1季 → 01（零填充两位）
#   - 散文件补全资源目录：监控目录下的散文件自动归入 "片名 (年份) {tmdb-ID}/" 目录
#   - 剧集散文件补建季子目录并移入
SHARE_NORMALIZE_ENABLED=false
# 标准化模拟模式（默认 true）：只出日志不实际重命名/移动，观察拟名质量后改 false
SHARE_NORMALIZE_DRY_RUN=true

# ===== 代理（TG Bot API + TMDB API 必须走代理）=====
# 形如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=

# ===== 频道监控（可选，Telethon 用户账号）=====
# 申请：https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# 是否启用频道监控（默认 true）
MONITOR_ENABLED=true
# 登录态文件（随 data 卷持久化；推荐 Bot 内 /mon login 交互式登录）
MONITOR_SESSION=./data/monitor.session
# 监控配置存储路径
MONITOR_DB_PATH=./data/monitor.db
# 默认聚合窗口秒数（0=实时逐条，可被 /mon batch 覆盖）
MONITOR_BATCH_SECONDS=0
# 频道监控（Telethon）断连/重连/补扫等运行事件私信 admin（默认 true）
MONITOR_NOTIFY=true

# ===================== 统一媒体流水线（方案二整合） =====================
# 一个服务跑完全链：目录A（下载落地）→ TMDB 重命名 → B 资源库
#   → ed2k 哈希（记 JSONL 审计账本）→ 频道卡片 → CD2 串行上传 115 → 删源
# 替代原 LOCAL_MEDIA / ED2K / ED2K_PUSH / CD2 四段服务与 A/B/C 三目录
# （旧四段开关在启动日志会提示迁移；旧 .env 配置不再生效）
#
# 模拟模式（DRY_RUN）：三个阶段开关各管一段，都默认 true（安全先行）。
# 切换语义（改 .env 后 /reload 即时生效，无需重启）：
#   · 任意 *_DRY_RUN=true → false：该段立即实际执行（模拟过的条目不被跳过）
# ⚠ 模拟的"深度"并不相同——不是所有模拟都只出日志：
#   · ① 重命名模拟：仍会真实调用 TMDB API（产生匹配日志）
#   · ② 推送模拟：仍会真实哈希 + 真实写 data/ed2k_results.jsonl
#   · ③ 上传模拟：仍会真实查重 115 目标目录
#
#   开关                     | 管哪段       | 模拟时做什么
#   ------------------------ | ----------- | -----------------------------
#   PIPELINE_RENAME_DRY_RUN  | ① A→B 重命名 | 只出"拟移动"日志（+真 TMDB）
#   PIPELINE_PUSH_DRY_RUN    | ② B→卡片     | 真哈希+记 JSONL，不推频道
#   PIPELINE_UPLOAD_DRY_RUN  | ③ B→115     | 真查重，不提交上传任务
#
# 总开关（默认 false）
PIPELINE_ENABLED=false
# 目录A：下载落地（递归监控 + 稳定判定；外部手动投喂也放这里）
PIPELINE_INPUT_DIR=
# 目录B：资源库（重命名+哈希+待上传；须挂在 CD2 里，勿手动投放）
PIPELINE_LIBRARY_DIR=
PIPELINE_RENAME_DRY_RUN=true
PIPELINE_PUSH_DRY_RUN=true
PIPELINE_UPLOAD_DRY_RUN=true
# 轮询周期秒（默认 10；哈希/推送/上传追踪都在同一轮询里）
PIPELINE_INTERVAL_SECONDS=10
# A 侧稳定判定轮数（默认 3，即约 30s；全链唯一一处稳定判定）
PIPELINE_STABLE_ROUNDS=3
# 单轮最多重命名的文件数（默认 5）：防一次性几十上百个打爆 IO/TMDB
PIPELINE_BATCH_MAX=5
# 各阶段失败卡死告警阈值天
PIPELINE_STUCK_DAYS=7
# 最小体积守门（MB，默认 10）：低于视为下载残缺占位文件拦截；设 0 关闭
PIPELINE_MIN_SIZE_MB=10
# mtime 静默年龄守门（分钟，默认 5）：最近 N 分钟内有写入的文件不动——
# TG 下载器分片/flood wait 停顿可骗过 30s 快照稳定判定（半截文件 rename
# 走会中断下载器后续写入，NAS 实发半截上传 115），mtime 随写持续更新，
# 写完才静止。手动投喂的文件最多等 N 分钟即处理；设 0 关闭（不建议）
PIPELINE_MIN_AGE_MINUTES=5
# 有动作的轮次把汇总+明细私信 admin（默认 true；旧键 CD2_REPORT_ADMIN 兼容）
PIPELINE_REPORT_ADMIN=true
# ---- 元数据清洗（L1 保守档，默认关闭）----
# 检测三类垃圾并 ffmpeg remux 清洗（零重编码，速度=磁盘拷贝）：
#   容器广告标签（title 塞网址等）/ 垃圾章节（title 含广告）/ 广告音轨字幕轨
# （title 命中关键词才删；正常章节、附件、语言轨一律不动；画面水印洗不掉）
# false=原样移动零开销；true+DRY_RUN=只检测报告不动文件；true+false=实际清洗
PIPELINE_CLEAN_ENABLED=false
PIPELINE_CLEAN_DRY_RUN=true

# ---- CD2 连接（上传阶段用） ----
# CloudDrive2 gRPC 地址（默认端口 19798）
CD2_ADDRESS=192.168.1.202:19798
# API 令牌（推荐；CD2 Web UI → 设置/账户 → API 令牌 创建）
CD2_TOKEN=
# 或账号密码（CD2_TOKEN 优先；都配时只用 token）
CD2_USERNAME=
CD2_PASSWORD=
# 目录B 在 CD2 里的路径（本地磁盘挂载到 CD2 后的路径，如 /media/media/B）
CD2_UPLOAD_SRC=/media/media/B
# 115 在 CD2 里的目标目录（如 /115open/临时目录）
CD2_UPLOAD_DST=/115open/临时目录

# ===== 其他 =====
LOG_LEVEL=INFO
# SQLite 缓存路径
DB_PATH=./data/cache.db
# 是否彩色日志
LOG_COLOR=true
# 核心日志文件（系统内容；媒体流水线日志只进 LOG_MEDIA_FILE，互不重复）
LOG_FILE=./data/logs/mediapush.log
# 媒体流水线独立日志文件（app.media.* 模块）
LOG_MEDIA_FILE=./data/logs/media.log
# 单日志文件轮转阈值（字节，达到即刻轮转 + gzip 压缩；默认 5MB）
LOG_MAX_BYTES=5242880
# 轮转归档保留天数（按文件时间清理，默认 7 天）
LOG_RETENTION_DAYS=7
# 各服务统一状态存储（pipeline 等一行一服务）
STATE_DB_PATH=./data/state.db

